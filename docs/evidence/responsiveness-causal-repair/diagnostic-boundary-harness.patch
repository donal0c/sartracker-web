+/** Diagnostic-only main-realm transaction boundaries; no SQL parameters or disk writes. */
+function installSQLiteBoundaryProbe() {
+  const require = process.getBuiltinModule('module').createRequire(`${process.resourcesPath}/app.asar/package.json`)
+  const Database = require('better-sqlite3')
+  const original = Database.prototype.transaction
+  const transactions = []
+  const episodes = []
+  let droppedTransactions = 0
+  let droppedEpisodes = 0
+  let episode = null
+  let stopped = false
+  let sentinel = null
+  const startedAtMs = performance.now()
+  Database.prototype.transaction = function(callback) {
+    const db = this
+    let active = null
+    const transaction = original.call(db, function(...args) {
+      if (active) active.callbackStartMs = performance.now()
+      try { return callback.apply(this, args) }
+      finally { if (active) active.callbackEndMs = performance.now() }
+    })
+    const invoke = function(mode, receiver, args) {
+      if (stopped || db.inTransaction) return transaction[mode].apply(receiver, args)
+      const row = { mode, startMs: performance.now(), callbackStartMs: null, callbackEndMs: null, endMs: null, outcome: 'ok' }
+      if (episode === null) {
+        episode = { startMs: row.startMs, endMs: null, transactionCount: 0, totalTransactionMs: 0, maximumTransactionMs: 0 }
+        sentinel = setImmediate(() => {
+          episode.endMs = performance.now()
+          if (episodes.length < 10000) episodes.push(episode)
+          else droppedEpisodes++
+          episode = null
+        })
+      }
+      active = row
+      try { return transaction[mode].apply(receiver, args) }
+      catch (error) { row.outcome = error.code || error.name; throw error }
+      finally {
+        row.endMs = performance.now()
+        active = null
+        episode.transactionCount++
+        episode.totalTransactionMs += row.endMs - row.startMs
+        episode.maximumTransactionMs = Math.max(episode.maximumTransactionMs, row.endMs - row.startMs)
+        if (transactions.length < 20000) transactions.push(row)
+        else droppedTransactions++
+      }
+    }
+    const wrapped = function(...args) { return invoke('deferred', this, args) }
+    for (const mode of ['deferred', 'immediate', 'exclusive']) {
+      wrapped[mode] = function(...args) { return invoke(mode, this, args) }
+    }
+    return wrapped
+  }
+  globalThis.__SAR_SQL_BOUNDARIES__ = {
+    stop() {
+      stopped = true
+      Database.prototype.transaction = original
+      clearImmediate(sentinel)
+      return { timeOriginMs: performance.timeOrigin, startedAtMs, stoppedAtMs: performance.now(), transactions, episodes, incompleteEpisode: episode, droppedTransactions, droppedEpisodes }
+    },
+  }
+  return { installed: true, startedAtMs }
+}
